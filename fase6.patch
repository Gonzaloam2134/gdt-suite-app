+  if (invitacion.expirada || invitacion.estado === 'expirada') return <Mensaje icono="⏰" titulo="La invitación venció" texto="Los links duran 7 días. Pedile uno nuevo a quien te invitó." />
+
+  const aceptar = async () => {
