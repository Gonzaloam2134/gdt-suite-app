+  totales: { cobros: 0, gastos: 0, efectivoCobrado: 0, efectivoGastado: 0, disponibleHoy: 0, pendienteAcreditacion: 0, comisiones: 0, netoReal: 0 },
   cobros: [], gastos: [], acreditacionesHoy: [], desgloseMedios: [],
 }
 
diff --git a/lib/domain/transacciones.js b/lib/domain/transacciones.js
index 40f608c..6ef89d0 100644
--- a/lib/domain/transacciones.js
+++ b/lib/domain/transacciones.js
@@ -97,7 +97,8 @@ export const calcularTotalesDia = (transacciones, diaISO) => {
   const totales = {
     cobros: 0,
     gastos: 0,
-    efectivoEnCaja: 0,
+    efectivoCobrado: 0,     // cobros en efectivo del día
+    efectivoGastado: 0,     // gastos pagados en efectivo (salen de la misma caja)
     disponibleHoy: 0,       // se completa aparte con calcularAcreditacionesDia: ver nota abajo
     pendienteAcreditacion: 0,
     comisiones: 0,
@@ -122,6 +123,8 @@ export const calcularTotalesDia = (transacciones, diaISO) => {
 
     if (esGasto(t)) {
       totales.gastos += monto
+      // Un gasto pagado en efectivo sale del cajón: descuenta del arqueo
+      if (esEfectivo(medio)) totales.efectivoGastado += monto
       gastos.push(t)
       continue
     }
@@ -136,7 +139,7 @@ export const calcularTotalesDia = (transacciones, diaISO) => {
     cobros.push({ ...t, comision, neto })
 
     if (esEfectivo(medio)) {
-      totales.efectivoEnCaja += monto
+      totales.efectivoCobrado += monto
     } else if (acreditaISO !== diaISO) {
       // Si acredita en diaISO no es "pendiente": es "disponible" (ver
       // calcularAcreditacionesDia). "Pendiente" acá es relativo a diaISO, NO a
@@ -195,9 +198,16 @@ export const calcularAcreditacionesDia = (transacciones) => {
   }
 }
 
-/** Efectivo que debería haber al cerrar: monto inicial + cobros en efectivo del día */
+/**
+ * Efectivo que debería haber FÍSICAMENTE en la caja en este momento:
+ * lo que se puso al abrir, más lo cobrado en efectivo, menos lo que se pagó
+ * en efectivo desde el mismo cajón.
+ *
+ * Es el número que el dashboard muestra durante el día y contra el que se
+ * cuenta al cerrar: los dos tienen que dar igual, si no el cierre sorprende.
+ */
 export const efectivoEsperado = (montoInicial, totales) =>
-  redondear(num(montoInicial) + num(totales?.efectivoEnCaja))
+  redondear(num(montoInicial) + num(totales?.efectivoCobrado) - num(totales?.efectivoGastado))
 
 // ---------------------------------------------------------------------------
 // Resumen de período (reportes)
