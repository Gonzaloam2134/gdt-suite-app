diff --git a/components/caja/KpiCards.jsx b/components/caja/KpiCards.jsx
index 7cf2e51..7d7dd6b 100644
--- a/components/caja/KpiCards.jsx
+++ b/components/caja/KpiCards.jsx
@@ -1,5 +1,7 @@
 import KpiCard from './KpiCard'
 import { usePreferencia } from '../../hooks/usePreferencia'
+import { efectivoEsperado } from '../../lib/domain/transacciones'
