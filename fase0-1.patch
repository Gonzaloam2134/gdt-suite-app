+const debito   = { nombre: 'Débito',   tipo: 'debito',   comision_porcentaje: 0, plazo_acreditacion_dias: 0 }
+
+let n = 0
+const tx = (over) => ({
+  id: `tx-${++n}`, tipo: 'COBRO_RECIBIDO', monto: 1000, es_reversa: false, revertida: false,
